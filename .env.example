# Copy to .env (`cp .env.example .env`). The backend and the Makefile read it.

# --- Backend ----------------------------------------------------------------
# Comma-separated origins allowed to call the API. Required, no wildcard.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
LOG_JSON=false

# --- AI provider (OpenRouter, or any OpenAI-compatible /chat/completions API)
# Get a key at https://openrouter.ai/settings/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Comma-separated model IDs shown in the UI picker; the first is the default.
# Paid models need OpenRouter credits (about $0.0001-0.001 per edit with these).
LLM_MODELS=anthropic/claude-haiku-5.5,google/gemini-3.8-flash,openai/gpt-5-mini
# No credits? Use free models instead (limit ~20 requests/min, 50/day), e.g.:
# LLM_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
# Seconds one AI call may take before it fails.
LLM_TIMEOUT_SECONDS=60

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
