# Copy to .env (`cp .env.example .env`). The backend and the Makefile read it.

# --- Backend ----------------------------------------------------------------
# Comma-separated origins allowed to call the API. Required, no wildcard.
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- AI provider (any OpenAI-compatible /chat/completions API) -------------
# Dev: Groq free tier. Production: OpenRouter (https://openrouter.ai/api/v1).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Comma-separated model IDs shown in the UI picker; the first is the default.
LLM_MODELS=llama-3.3-70b-versatile

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
